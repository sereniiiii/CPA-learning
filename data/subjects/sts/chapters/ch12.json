{"id":"ch12","num":12,"title":"国际税收税务管理实务","volume":"下册","info":{"guide":"和实践方面有了更丰富的拓展，也加入了BEPS行动计划，签署并生效 实施了《多边税收征管互助公约》,在消除有害竞争、处理税基侵蚀和利 润转移、打击跨境逃避税行为、维护公平税收秩序等问题上有了更多的 话语权。本章就是基于近年国际税收理论与实践不断发展的现状，将非 居民企业管理、特别纳税调整等反避税规则全面收录，给CPA考生展示 了新的视野，提出了新的知识面要求。","changes":["(1)新增：境外投资者以分配利润直接投资税收抵免政策。","(2)调整："]},"pointsFramework":[],"sections":[{"num":1,"title":"国际税收协定","points":[]},{"num":2,"title":"非居民企业税收管理","points":[]},{"num":3,"title":"境外所得税收管理","points":[]},{"num":4,"title":"国际反避税","points":[]},{"num":5,"title":"转让定价税务管理","points":[{"num":4,"title":")转让定价调查及调整","difficulty":null,"hot":null,"examples":[{"no":36,"type":"多选题","source":{"volume":"下册","pdfPage":180,"printPage":180},"status":"待核","render":"screenshot","answer":null}],"source":{"volume":"下册","pdfPage":177,"printPage":177},"status":"待核","render":"screenshot","blocks":[]}]},{"num":6,"title":"国际税收征管合作","points":[]}],"exercises":[{"source":{"volume":"下册","pdfPage":124,"printPage":124},"status":"待核","block":"exercise-down-0124.png"},{"source":{"volume":"下册","pdfPage":125,"printPage":125},"status":"待核","block":"exercise-down-0125.png"},{"source":{"volume":"下册","pdfPage":126,"printPage":126},"status":"待核","block":"exercise-down-0126.png"},{"source":{"volume":"下册","pdfPage":128,"printPage":128},"status":"待核","block":"exercise-down-0128.png"},{"source":{"volume":"下册","pdfPage":130,"printPage":130},"status":"待核","block":"exercise-down-0130.png"},{"source":{"volume":"下册","pdfPage":131,"printPage":131},"status":"待核","block":"exercise-down-0131.png"},{"source":{"volume":"下册","pdfPage":132,"printPage":132},"status":"待核","block":"exercise-down-0132.png"},{"source":{"volume":"下册","pdfPage":134,"printPage":134},"status":"待核","block":"exercise-down-0134.png"},{"source":{"volume":"下册","pdfPage":135,"printPage":135},"status":"待核","block":"exercise-down-0135.png"},{"source":{"volume":"下册","pdfPage":136,"printPage":136},"status":"待核","block":"exercise-down-0136.png"},{"source":{"volume":"下册","pdfPage":139,"printPage":139},"sta