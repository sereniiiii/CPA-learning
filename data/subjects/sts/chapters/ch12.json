-00.png"}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":1,"stem":"1.外国企业常驻代表机构是指按照国务院有关规定，在工商行政管理部门登记或经有关","block":"ex-down-0130-g004-00.png","page":130,"answer":null,"answerBlock":null},{"no":2,"stem":"2.代表机构除应按我国相关工商法规办理营业执照(或经有关部门批准)外，还应当自","block":"ex-down-0130-g004-01.png","page":130,"answer":null,"answerBlock":null},{"no":3,"stem":"3.财务核算是否健全决定所得税的征收方式。代表机构的所得税申报方式有两种：即据","block":"ex-down-0130-g004-02.png","page":130,"answer":null,"answerBlock":null},{"no":4,"stem":"4.代表机构在境内的纳税义务不只是企业所得税，目前还有增值税、城建税、教育费附","block":"ex-down-0130-g004-03.png","page":130,"answer":null,"answerBlock":null},{"no":5,"stem":"5.按照企业所得税法第51条，代表机构的纳税地点是机构、场所所在地。代表机构应在","block":"ex-down-0130-g004-04.png","page":130,"answer":null,"answerBlock":null},{"no":6,"stem":"6.代表机构在计算缴纳增值税的同时还需要计算应缴纳的城市维护建设税、教育费附加","block":"ex-down-0130-g004-05.png","page":130,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":1,"stem":"1.《非居民承包工程作业和提供劳务税收管理暂行办法》只适用于非居民纳税人(包括非","block":"ex-down-0131-g005-00.png","page":131,"answer":null,"answerBlock":null},{"no":2,"stem":"2.本规定只适用于非居民纳税人在我国境内从事的承包工程作业和提供劳务活动两大","block":"ex-down-0131-g005-01.png","page":131,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":1,"stem":"1.支付人自行委托代理人或指定其他第三方代为支付相关款项，或者因担保合同或法律","block":"ex-down-0132-g006-00.png","page":132,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":3,"stem":"3.扣缴义务人在申报和解缴应扣税款时，应填报《中华人民共和国扣缴企业所得税报","block":"ex-down-0134-g007-00.png","page":134,"answer":null,"answerBlock":null},{"no":5,"stem":"5.扣缴非居民企业应纳税款的相关法律责任和举措。","block":"ex-down-0134-g007-02.png","page":134,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":6,"stem":"6.扣缴义务人所在地主管税务机关为扣缴义务人所得税主管税务机关。","block":"ex-down-0136-g008-00.png","page":136,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":1,"stem":"1.境外机构或个人从境内获得的包括运输、旅游、通信、建筑安装及劳务承包、保险服务、","block":"ex-down-0139-g009-00.png","page":139,"answer":null,"answerBlock":null},{"no":2,"stem":"2.境外个人在境内的工作报酬，境外机构或个人从境内获得的股息、红利、利润、直接","block":"ex-down-0139-g009-01.png","page":139,"answer":null,"answerBlock":null},{"no":3,"stem":"3.境外机构或个人从境内获得的融资租赁租金、不动产的转让收入、股权转让所得以及","block":"ex-down-0139-g009-02.png","page":139,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":1,"stem":"1.境内机构在境外发生的差旅、会议、商品展销等各项费用；","block":"ex-down-0139-g010-00.png","page":139,"answer":null,"answerBlock":null},{"no":2,"stem":"2.境内机构在境外代表机构的办公经费，以及境内机构在境外承包工程的工程款；","block":"ex-down-0139-g010-01.png","page":139,"answer":"C","answerBlock":"ans-down-0190-g010-00.png"},{"no":3,"stem":"3.境内机构发生在境外的进出口贸易佣金、保险费、赔偿款；","block":"ex-down-0139-g010-02.png","page":139,"answer":"B","answerBlock":"ans-down-0190-g010-01.png"},{"no":5,"stem":"5.保险项下保费、保险金等相关费用；","block":"ex-down-0139-g010-04.png","page":139,"answer":null,"answerBlock":null},{"no":6,"stem":"6.从事运输或远洋渔业的境内机构在境外发生的修理、油料、港杂等各项费用；","block":"ex-down-0139-g010-05.png","page":139,"answer":"D","answerBlock":"ans-down-0190-g010-03.png"},{"no":7,"stem":"7.境内旅行社从事出境旅游业务的团费以及代订、代办的住宿、交通等相关费用；","block":"ex-down-0139-g010-06.png","page":139,"answer":"D","answerBlock":"ans-down-0190-g010-04.png"},{"no":8,"stem":"8.亚洲开发银行和世界银行集团下属的国际金融公司从我国取得的所得或收入，包括投","block":"ex-down-0139-g010-07.png","page":139,"answer":"D","answerBlock":"ans-down-0190-g010-05.png"},{"no":9,"stem":"9.外国政府和国际金融组织向我国提供的外国政府(转)贷款[含外国政府混合(转)贷款]","block":"ex-down-0139-g010-08.png","page":139,"answer":"D","answerBlock":"ans-down-0190-g010-06.png"},{"no":10,"stem":"10.外汇指定银行或财务公司自身对外融资，如境外借款、境外同业拆借、海外代付以及","block":"ex-down-0139-g010-09.png","page":139,"answer":"A","answerBlock":"ans-down-0190-g010-07.png"},{"no":11,"stem":"11.我国省级以上国家机关对外无偿捐赠援助资金；","block":"ex-down-0139-g010-10.png","page":139,"answer":"D","answerBlock":"ans-down-0190-g010-08.png"},{"no":12,"stem":"12.境内证券公司或登记结算公司向境外机构或境外个人支付其依法获得的股息、红利、","block":"ex-down-0139-g010-11.png","page":139,"answer":null,"answerBlock":null},{"no":13,"stem":"13.境内个人境外留学、旅游、探亲等因私用汇；","block":"ex-down-0139-g010-12.png","page":139,"answer":null,"answerBlock":null},{"no":14,"stem":"14.境内机构和个人办理服务贸易、收益和经常转移项下退汇；","block":"ex-down-0139-g010-13.png","page":139,"answer":null,"answerBlock":null},{"no":15,"stem":"15.外国投资者以境内直接投资合法所得在境内再投资；","block":"ex-down-0139-g010-14.png","page":139,"answer":null,"answerBlock":null},{"no":16,"stem":"16.财政预算内机关、事业单位、社会团体非贸易非经营性付汇业务；","block":"ex-down-0139-g010-15.png","page":139,"answer":null,"answerBlock":null},{"no":17,"stem":"17.国家规定的其他情形。","block":"ex-down-0139-g010-16.png","page":139,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":2,"stem":"2.非居民企业在中国境内设立机构、场所的，其取得发生在境外但与该机构、场所有实","block":"ex-down-0141-g011-01.png","page":141,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":1,"stem":"1.直接抵免——对企业直接作为纳税人在境外缴纳税款的抵扣(常见总分机构之间)。","block":"ex-down-0142-g012-00.png","page":142,"answer":null,"answerBlock":null},{"no":2,"stem":"2.间接抵免——对进行境外投资的分红所得已纳税款的抵扣(母子或母子孙公司之间)。","block":"ex-down-0142-g012-01.png","page":142,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":1,"stem":"1.企业应按照税法的有关规定准确计算下列当期与抵免境外所得税有关的项目后，确定","block":"ex-down-0142-g013-00.png","page":142,"answer":null,"answerBlock":null},{"no":2,"stem":"2.自2017年1月1日起，企业可以选择按国(地区)别分别计算[“分国(地区)不分项”],","block":"ex-down-0142-g013-01.png","page":142,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":2,"stem":"2.由于分支机构不具有分配利润职能，居民企业在境外设立不具有独立纳税地位的分支","block":"ex-down-0142-g014-01.png","page":142,"answer":null,"answerBlock":null},{"no":3,"stem":"3.确认收入实现的时间以及对应调整费用扣除——发生时间确认及所得额完整性的确认。","block":"ex-down-0142-g014-02.png","page":142,"answer":null,"answerBlock":null}]},{"chapterNum":12,"chapterTitle":"国际税收税务管理实务","items":[{"no":5,"stem":"5.共同支出的合理分摊。","block":"ex-down-0144-g015-01.png","page":